# URL base de la API Laravel, incluyendo el prefijo /api.
# Sin esta variable, el frontend usa la ruta relativa "/api" y depende del
# rewrite en next.config.ts (solo funciona si frontend y backend corren en
# la misma maquina, como en desarrollo local).
#
# En despliegues donde el backend vive en otro dominio/servidor (Hostinger,
# Railway, un tunel de ngrok, etc.) hay que definir esta variable con la URL
# publica real del backend. Debe empezar en https:// en produccion.
#
# Ejemplo local:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api
#
# Ejemplo produccion:
# NEXT_PUBLIC_API_URL=https://api.tu-dominio.com/api
NEXT_PUBLIC_API_URL=

# URL publica del sitio (metadata OG, sitemap.xml, robots.txt). Sin esta
# variable cae a http://localhost:3000. Definir con el dominio real en cada
# despliegue.
# Ejemplo: NEXT_PUBLIC_SITE_URL=https://demo.tu-dominio.com
NEXT_PUBLIC_SITE_URL=

# Plan comercial de este despliegue.
#
#   (sin definir / vacío)  -> PRODUCTO COMPLETO. Es el default y lo que debe
#                             correr la DEMO comercial de Control de Inventario
#                             + CRM: todos los módulos y widgets visibles.
#   NEXT_PUBLIC_PLAN=base   -> plan de entrada ($199.900), SOLO para una venta
#                             puntual de ese plan. Oculta en el menú y bloquea
#                             las rutas de CRM Pro (contactos, segmentos, notas,
#                             deals, actividades, tareas, seguimientos, calendario),
#                             Inventario Pro (transferencias, alertas de stock,
#                             órdenes de compra), Analítica (reportes) y auditoría/
#                             roles, y recorta los KPIs/gráficos del dashboard.
#                             "Modo contingencia" y "Asistente IA" quedan como
#                             botón Premium bloqueado (gancho de venta).
#
# Gate solo-frontend: la API responde igual. Ver docs/plan-base.md. Vender un
# add-on = editar BASE_PLAN_HIDDEN / BASE_PLAN_PREMIUM en src/lib/plan.ts.
# NO definir esta variable en la demo ni en un cliente que compró el sistema completo.
NEXT_PUBLIC_PLAN=

# Atajos de "usuarios demo" en el login (Super Admin, RRHH, etc., password
# "password"). Seguro por defecto: ocultos en produccion, visibles en desarrollo.
# Poner "true" para forzarlos (dominio showcase) o "false" para ocultarlos siempre.
NEXT_PUBLIC_DEMO_MODE=
